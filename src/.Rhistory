dim(df.pheno)
dim(meta_PD)
comm_id
df.pheno <- meta_PD[meta_PD$PATNO %in% comm_id,] %>%
mutate(UPDRS_I = updrs1_score,
UPDRS_II = NP2PTOT,
UPDRS_III = NP3TOT,
MoCA = MCATOT)
df.pheno$cluster <- as.character(best.cluster.Bayes)
dim(df.pheno)
table(df.pheno$SEX)
table(df.pheno$SEX, df.pheno$cluster)
df.pheno %>% group_by(cluster) %>% summarise(mean(AGE_AT_VISIT), sd(AGE_AT_VISIT))
df.pheno %>% group_by(cluster) %>% summarise(mean(duration_yrs), sd(duration_yrs))
table(df.pheno$type_mutation, df.pheno$cluster)
saa <- read.csv("/Volumes/Extreme SSD/work_bidmc/PPMI/meta_data/LONI/SAA_Biospecimen_Analysis_Results_17Jan2024.csv")
saa <- saa %>%
filter(CLINICAL_EVENT == "BL" & SAA_Status != "Inconclusive") %>%
mutate(PATNO = paste0("PP-", PATNO)) %>% arrange(PATNO) %>%
select(PATNO, SAA_Status) %>%
distinct(PATNO, .keep_all = T)
df.pheno <- merge(df.pheno, saa, by = "PATNO", all.x = T)
table(df.pheno$SAA_Status, df.pheno$cluster)
table(df.pheno$tupe)
table(df.pheno$type_mutation, df.pheno$cluster)
table(df.pheno$type_mutation, df.pheno$cluster)[, 1]/153
table(df.pheno$type_mutation, df.pheno$cluster)[, 2]/220
chisq.test(table(df.pheno$SEX, df.pheno))
chisq.test(table(df.pheno$SEX, df.pheno$cluster))
t.test(df.pheno$AGE_AT_VISIT[df.pheno$cluster == 1], df.pheno$AGE_AT_VISIT[df.pheno$cluster == 2])
t.test(df.pheno$duration_yrs[df.pheno$cluster == 1], df.pheno$duration_yrs[df.pheno$cluster == 2])
chisq.test(table(df.pheno$type_mutation, df.pheno$cluster))
chisq.test(table(df.pheno$SAA_Status, df.pheno$cluster))
